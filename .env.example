# ---------------------------------------------------------------------------
# Data Reliability Agent - bien moi truong
# Copy sang .env (hoac export truc tiep) truoc khi chay.
# ---------------------------------------------------------------------------

# Sau khi dien xong, kiem tra bang:  python check_llm.py

# --- Ket noi MaaS (GreenNode / VNG Cloud), chuan OpenAI-compatible ---------
# De TRONG DRA_API_KEY -> app tu chay che do OFFLINE (bo nao mo phong, DuckDB that)
#
# DRA_BASE_URL : COPY CHINH XAC tu UI GreenNode (muc API Documentation / Endpoint).
#                Bat buoc ket thuc bang /v1. Tuy tenant, GreenNode dung 1 trong 2 host:
#                  https://maas.api.greennode.ai/v1
#                  https://maas.greennode.ai/v1
# DRA_MODEL    : COPY CHINH XAC model id tu UI (phan biet chu hoa/thuong, dau gach).
#                Model BAT BUOC ho tro function/tool calling.
#                Kiem tra bang: python check_llm.py
DRA_API_KEY=
DRA_BASE_URL=https://maas.api.greennode.ai/v1
DRA_MODEL=Llama-3.3-70B-Instruct
DRA_TEMPERATURE=0.1
DRA_MAX_TOKENS=2048
DRA_MAX_ITERATIONS=12
DRA_TIMEOUT=120

# --- CROSS-MODEL CHECKING (Agent 2 soi bang model khac Agent 1) ------------
# Ly do: hai agent dung chung model thi co cung diem mu, Checker se co xu huong
# dong thuan voi Maker thay vi bat loi (correlated failure).
#
# DRA_AUDITOR_MODEL : chi dinh cung model cho Checker.
#                     De trong -> boc round-robin tu pool, tu dong tranh model cua Maker.
#                     De trong + khong co pool -> dung chung model voi Maker.
DRA_AUDITOR_MODEL=
#
# DRA_MODEL_POOL    : danh sach model de LUAN CHUYEN (phan tach bang ',').
#                     Dung cho 2 viec:
#                       1. Checker boc model khac Maker (round-robin).
#                       2. FAILOVER: model rate-limit / 5xx / timeout thi tu chuyen
#                          sang model ke tiep trong pool.
#                     Moi model trong pool PHAI ho tro tool calling (kiem bang check_llm.py).
DRA_MODEL_POOL=
DRA_AUDITOR_MODEL_POOL=        # de trong = dung chung DRA_MODEL_POOL
#
DRA_AUDITOR_TEMPERATURE=
DRA_AUDITOR_MAX_TOKENS=
DRA_AUDITOR_MAX_ITERATIONS=

# --- DuckDB warehouse (Source + Sink) -------------------------------------
# LUU Y: de commented. Neu set o day thi `docker run --env-file .env` se ghi de
# duong dan trong container (Dockerfile da set /app/data/warehouse.duckdb va seed
# san 1000 dong), lam container tao lai DB moi o cho khac.
# DRA_DUCKDB_PATH=warehouse.duckdb
# DRA_RUNBOOK_DIR=runbooks
DRA_MAX_RESULT_ROWS=50

# --- Web server (cung ly do nhu tren, de container tu quyet) ---------------
# DRA_HOST=0.0.0.0
# PORT=8000

# --- Bao ve REST API /api/* (de trong = KHONG auth, chi dung khi demo local)
DRA_API_TOKEN=
